# Kopiera till .env och fyll i. .env är gitignorerad — kontrollera det innan du
# skriver in något. Filen läses av verktyg/starta-openwebui.sh med flera.
#
#   cp .env.example .env
#   git check-ignore -v .env      # ska svara att den ignoreras

# I SSP Cloud behöver du normalt INTE den här filen. Lägg i stället nycklarna i
# en Vault-hemlighet som monteras som miljövariabler när tjänsten startar — se
# docs/60-miljo/starta-labbet.md. Då finns de aldrig på disk i repot.

# --- Modelleverantör ------------------------------------------------------
# Plattformens egen inferens är OpenAI-kompatibel:
#   OPENAI_BASE_URL=https://llm.lab.sspcloud.fr/api
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
ANTHROPIC_API_KEY=

# Kör du en lokal modellserver (Ollama, vLLM) i samma miljö:
OLLAMA_BASE_URL=http://127.0.0.1:11434

# --- Metadatagrafen (pilotinstans, se docs/60-miljo/metadatagrafen.md) -----
# Uppgifterna delas ut av den som driver piloten. Lägg dem i Vault, inte här.
METADATAGRAF_URL=
METADATAGRAF_TOKEN=
METADATAGRAF_BASIC=

# --- Open WebUI -----------------------------------------------------------
# 8080 är upptagen av code-server. Porten måste exponeras vid tjänstestart.
OPEN_WEBUI_PORT=8081
# Katalog för Open WebUI:s databas och uppladdningar. Gitignorerad.
DATA_DIR=./open-webui-data
# Sätts till en slumpad sträng första gången, återanvänd den sedan:
#   openssl rand -hex 32
WEBUI_SECRET_KEY=

# --- Vektor-/grafminne (om du startat sådana tjänster i Onyxia) -----------
QDRANT_URL=
NEO4J_URI=
NEO4J_USER=
NEO4J_PASSWORD=

# --- GitHub ---------------------------------------------------------------
# Behövs normalt INTE. gh cli sköter git-autentiseringen i labbmiljön.
# Se docs/60-miljo/git-och-auth.md.
